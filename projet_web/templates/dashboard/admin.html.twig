{% extends 'base.html.twig' %}

{% block title %}Administration | psydesk{% endblock %}

{% block body %}
<div style="display: flex; min-height: 100vh;">
    <!-- Sidebar -->
    <div style="width: 260px; background: linear-gradient(135deg, #5e7daf 0%, #5e7daf 100%); color: white; padding: 20px;">
        <h3 style="text-align: center; margin-bottom: 30px;">⚡ Admin PSYDESK</h3>
        <div style="margin-bottom: 10px; padding: 10px; background: rgba(255,255,255,0.2); border-radius: 10px;">📊 Tableau de bord</div>
        <div style="margin-bottom: 10px; padding: 10px;">👥 Utilisateurs</div>
        <div style="margin-bottom: 10px; padding: 10px;">📈 Statistiques</div>
        <hr style="margin: 20px 0;">
        <a href="{{ path('app_logout') }}" style="color: white; text-decoration: none; display: block; padding: 10px;">🚪 Déconnexion</a>
    </div>

    <!-- Main Content -->
    <div style="flex: 1; padding: 20px; background: #f5f7fb;">
        <div style="background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px;">
            <h2>Tableau de bord</h2>
            <p>Bienvenue, <strong>{{ user.fullName }}</strong> !</p>
        </div>

        <!-- Stats -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 20px;">
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #667eea;">{{ users|length }}</div>
                <div>Total utilisateurs</div>
            </div>
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #f4d3ec;">{{ users|filter(u => 'ROLE_PATIENT' in u.roles)|length }}</div>
                <div>Patients</div>
            </div>
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #b596b3;">{{ users|filter(u => 'ROLE_PSYCHOLOGUE' in u.roles)|length }}</div>
                <div>Psychologues</div>
            </div>
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #e944ef;">{{ users|filter(u => 'ROLE_ADMIN' in u.roles)|length }}</div>
                <div>Administrateurs</div>
            </div>
        </div>

        <!-- Messages Flash -->
        {% for message in app.flashes('success') %}
            <div style="background: #d1fae5; color: #5e7daf; padding: 12px; border-radius: 10px; margin-bottom: 20px;">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div style="background: #fee2e2; color: #bfabdf; padding: 12px; border-radius: 10px; margin-bottom: 20px;">{{ message }}</div>
        {% endfor %}

        <!-- User Table -->
        <div style="background: white; border-radius: 15px; padding: 20px;">
            <h3>Liste des utilisateurs</h3>
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f8f9fa;">
                        <th style="padding: 12px; text-align: left;">ID</th>
                        <th style="padding: 12px; text-align: left;">Nom</th>
                        <th style="padding: 12px; text-align: left;">Email</th>
                        <th style="padding: 12px; text-align: left;">Âge</th>
                        <th style="padding: 12px; text-align: left;">Rôle</th>
                        <th style="padding: 12px; text-align: left;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 12px;">{{ u.id }}</td>
                        <td style="padding: 12px;">{{ u.fullName }}</td>
                        <td style="padding: 12px;">{{ u.email }}</td>
                        <td style="padding: 12px;">{{ u.age }}</td>
                        <td style="padding: 12px;">
                            {% if 'ROLE_ADMIN' in u.roles %}
                                <span style="background: #667eea; color: white; padding: 5px 10px; border-radius: 20px;">Admin</span>
                            {% elseif 'ROLE_PSYCHOLOGUE' in u.roles %}
                                <span style="background: #5e7daf; color: white; padding: 5px 10px; border-radius: 20px;">Psychologue</span>
                            {% else %}
                                <span style="background: #b596b3; color: white; padding: 5px 10px; border-radius: 20px;">Patient</span>
                            {% endif %}
                        </td>
                        <td style="padding: 12px;">
                            <a href="{{ path('app_admin_user_edit', {'id': u.id}) }}" 
                               style="background: #b596b3; color: white; padding: 5px 12px; border-radius: 8px; text-decoration: none; margin-right: 5px; display: inline-block;">
                                ✏️ Modifier
                            </a>
                            
                            {% if u.id != user.id %}
                                <form method="post" action="{{ path('app_admin_user_delete', {'id': u.id}) }}" 
                                      style="display: inline-block;" 
                                      onsubmit="return confirm('Supprimer définitivement {{ u.fullName }} ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                                    <button type="submit" 
                                            style="background: #5e7daf; color: white; border: none; padding: 5px 12px; border-radius: 8px; cursor: pointer;">
                                        🗑️ Supprimer
                                    </button>
                                </form>
                            {% else %}
                                <span style="background: #9ca3af; color: white; padding: 5px 12px; border-radius: 8px;">Vous</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}