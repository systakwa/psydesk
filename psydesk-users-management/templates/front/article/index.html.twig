            <!-- About Section-->


{% block body %}

<div class="container py-4" style="max-width: 600px;">

<h3 class="d-flex align-items-center">📰 Fil d’actualité</h3>
{% for message in app.flashes('warning') %}
<script>
document.addEventListener("DOMContentLoaded", function() {
    Swal.fire({
        icon: 'warning',
        title: 'Attention ⚠️',
        text: "{{ message|e('js') }}"
    });
});
</script>
{% endfor %}

{% for article in articles %}
<div class="card mb-4 shadow-sm">

    <!-- HEADER -->
    <div class="card-body pb-2">
        <div class="d-flex align-items-center">

            <img src="https://i.pravatar.cc/40" 
                 class="rounded-circle me-2" width="40">

            <div>
                <strong>
                    {{ article.user ? article.user.prenom ~ ' ' ~ article.user.nom : 'ADMIN' }}
                </strong><br>

                <small class="text-muted">
                    {{ article.datePost|date('d M Y H:i') }}
                </small>
            </div>

        </div>
    </div>

    <!-- CONTENU -->
    <div class="px-3 pb-2">
        {{ article.contenu }}
    </div>

    <!-- IMAGE -->
    {% if article.image %}
        <img src="{{ asset('uploads/' ~ article.image) }}" class="img-fluid">
    {% endif %}

    <!-- STATS -->
    <div class="px-3 py-2 text-muted small border-top">
        👍 {{ article.likes|length }} j’aime
        • 💬 {{ article.commentaires|length }} commentaires
    </div>

    <!-- ACTIONS -->
    <div class="d-flex border-top text-center">

        <a href="{{ path('front_article_article_like', {'id': article.id}) }}" 
           class="flex-fill p-2 text-decoration-none text-dark">
            👍 J’aime
        </a>

        <button class="flex-fill p-2 btn btn-light">
            💬 Commenter
        </button>

    </div>

    <!-- COMMENTAIRES -->
    <div class="px-3 py-2">

        {% for c in article.commentaires %}
            <div class="d-flex mb-2">

                <img src="https://i.pravatar.cc/30" 
                     class="rounded-circle me-2" width="30">

                <div class="bg-light p-2 rounded">
                    <strong>{{ c.user.prenom }}</strong><br>
                    <small>{{ c.contenu }}</small>
                </div>

            </div>
        {% endfor %}

    </div>

    <!-- FORM COMMENT -->
    <div class="px-3 pb-3 border-top">

        <form method="post" action="{{ path('front_article_article_comment', {'id': article.id}) }}" class="d-flex">

            <input type="text" name="contenu" class="form-control me-2" 
                   placeholder="Écrire un commentaire..." required>

            <button class="btn btn-primary btn-sm">Publier</button>

        </form>

    </div>

</div>
{% else %}
    <p class="text-center text-muted">Aucun article</p>
{% endfor %}

<a href="{{ path('front_article_new') }}" class="btn btn-primary w-100">
    ➕ Publier un article
</a>

</div>

{% endblock %}
        </main>
        <!-- Footer-->
        <footer class="bg-white py-4 mt-auto">
            <div class="container px-5">
                <div class="row align-items-center justify-content-between flex-column flex-sm-row">
                    <div class="col-auto"><div class="small m-0">Copyright &copy; Your Website 2023</div></div>
                    <div class="col-auto">
                        <a class="small" href="#!">Privacy</a>
                        <span class="mx-1">&middot;</span>
                        <a class="small" href="#!">Terms</a>
                        <span class="mx-1">&middot;</span>
                        <a class="small" href="#!">Contact</a>
                    </div>
                </div>
            </div>
        </footer>
        <!-- Bootstrap core JS-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- Core theme JS-->
        <script src="{{ asset('js/scripts.js') }}"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    </body>
</html>
