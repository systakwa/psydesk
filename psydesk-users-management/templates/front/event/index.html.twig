            <!-- About Section-->
{% block body %}
<style>
.meet-btn {
    background: linear-gradient(45deg, #007bff, #00c6ff);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: bold;
}

.meet-btn:hover {
    background: linear-gradient(45deg, #0056b3, #0099cc);
    transform: scale(1.02);
}

.participer-btn {
    background: linear-gradient(45deg, #ff4d6d, #ff85a2);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: bold;
}

.participer-btn:hover {
    background: linear-gradient(45deg, #e63950, #ff5c8a);
    transform: scale(1.02);
}
</style>


<!-- SECTION EVENTS -->
<section class="bg-light py-5">
<div class="container px-5">

    <!-- TITLE -->
    <div class="text-center mb-5">
        <h1 class="fw-bolder">Nos événements</h1>
        <p class="lead text-muted">Découvrez et participez à nos événements</p>
    </div>

    <!-- FLASH -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <!-- SEARCH -->
    <form method="get" class="mb-4">
        <input type="text" name="q" class="form-control" placeholder="Rechercher événement...">
    </form>

    <!-- CARDS -->
    <div class="row g-4">

    {% for evenement in evenements %}
    <div class="col-md-6 col-lg-4">

        <div class="card h-100 shadow border-0 rounded-4 overflow-hidden">

            <!-- IMAGE -->
            {% if evenement.image %}
                <img src="{{ asset('uploads/' ~ evenement.image) }}" 
                     class="card-img-top" 
                     style="height:200px; object-fit:cover;">
            {% else %}
                <img src="https://via.placeholder.com/400x200" 
                     class="card-img-top">
            {% endif %}

            <div class="card-body">

                <!-- TITLE -->
                <h5 class="fw-bold">
                    {{ evenement.titre }}

                    {% if evenement.dateEvent|date('Y-m-d') == "now"|date('Y-m-d') %}
                        <span class="badge bg-danger">🔴 EN DIRECT</span>
                    {% endif %}
                </h5>

                <!-- DESCRIPTION -->
                <p class="text-muted small">
                    {{ evenement.description|slice(0, 80) ~ '...' }}
                </p>

                <!-- INFOS -->
                <ul class="list-unstyled small mb-3">
                    <li>📅 {{ evenement.dateEvent|date('d/m/Y') }}</li>
                    <li>📍 {{ evenement.lieu }}</li>
                    <li>🏷 {{ evenement.type }}</li>
                    <li>👥 {{ evenement.participations|length }} participants</li>
                </ul>

            </div>

            <!-- ACTIONS -->
            <div class="card-footer bg-white border-0">

                {% if evenement.meetLink %}
                    <a href="{{ evenement.meetLink }}" target="_blank" 
                       class="btn w-100 mb-2 meet-btn">
                       🎥 Rejoindre la réunion
                    </a>
                {% endif %}

                <a href="{{ path('participer_event', {'id': evenement.id}) }}"
                   class="btn w-100 participer-btn">
                   💖 Participer
                </a>

            </div>

        </div>

    </div>

    {% else %}
        <div class="col-12 text-center">
            <p>Aucun événement</p>
        </div>
    {% endfor %}

    </div>

    <!-- CALENDAR -->
    <div class="mt-5">
        <h2 class="text-center mb-4">📅 Calendrier des événements</h2>
        <div id="calendar"></div>
    </div>

</div>
</section>

<!-- CALENDAR SCRIPT -->
<script>
document.addEventListener('DOMContentLoaded', function () {

    let calendarEl = document.getElementById('calendar');

    let calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        events: '/front/event/calendar',

        eventClick: function(info) {

            let eventId = info.event.id;

            let html = `
                <div style="padding:15px; text-align:center;">
                    <h5>${info.event.title}</h5>
                    <a href="/front/participation/participer/${eventId}" 
                       class="btn btn-success mt-3">
                       Participer
                    </a>
                </div>
            `;

            let popup = document.createElement("div");
            popup.innerHTML = html;

            popup.style.position = "fixed";
            popup.style.top = "50%";
            popup.style.left = "50%";
            popup.style.transform = "translate(-50%, -50%)";
            popup.style.background = "white";
            popup.style.padding = "20px";
            popup.style.borderRadius = "10px";
            popup.style.boxShadow = "0 0 15px rgba(0,0,0,0.3)";
            popup.style.zIndex = "9999";

            document.body.appendChild(popup);

            popup.addEventListener("click", () => popup.remove());
        }
    });

    calendar.render();
});
</script>

{% endblock %}
