<form method="post" action="{{ path('app_reservation_back_delete', {'id': reservation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réservation ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
    <button class="btn btn-danger btn-sm" type="submit">
        <i class="bi bi-trash3 me-2"></i>Supprimer
    </button>
</form>
