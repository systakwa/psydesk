{% extends 'base1.html.twig' %}

{% block title %}PsyDesk Admin - Statistiques Réservations{% endblock %}

{% block page_title %}📊 Statistiques des Réservations{% endblock %}
{% block page_subtitle %}Vue d'ensemble des réservations et des statuts{% endblock %}

{% block page_header_action %}
    <a href="{{ path('app_reservation_back_index') }}" class="btn btn-sm btn-secondary">
        ← Retour
    </a>
{% endblock %}

{% block body %}
<style>
    .container {
        margin-top: 30px;
    }

    .card {
        border: none;
        border-radius: 12px;
        background: #1e1e2f;
        color: #e0e0e0;
        margin-bottom: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
    }

    .card:hover {
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.2);
    }

    .card-body {
        padding: 25px;
    }

    .card-title {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .chart-container {
        position: relative;
        height: 400px;
        width: 100%;
        margin-bottom: 30px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .summary-box {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
        border: 1px solid rgba(102, 126, 234, 0.5);
    }

    .summary-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    .summary-box.pending {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        border: 1px solid rgba(245, 158, 11, 0.5);
    }

    .summary-box.pending:hover {
        box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
    }

    .summary-box.confirmed {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        border: 1px solid rgba(16, 185, 129, 0.5);
    }

    .summary-box.confirmed:hover {
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    }

    .summary-box.cancelled {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        border: 1px solid rgba(239, 68, 68, 0.5);
    }

    .summary-box.cancelled:hover {
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
    }

    .summary-value {
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .summary-label {
        font-size: 14px;
        opacity: 0.95;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .btn-download {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 14px 30px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
        transition: all 0.3s ease;
        border: none;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-download:hover {
        background: linear-gradient(135deg, #5568d3 0%, #694095 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        color: white;
    }

    .table-responsive {
        margin-top: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #252535;
    }

    table thead {
        background-color: #1a1a28;
    }

    table th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
        color: #667eea;
        border-bottom: 2px solid #3d3d50;
    }

    table td {
        padding: 12px 15px;
        border-bottom: 1px solid #3d3d50;
        color: #ccc;
    }

    table tbody tr:hover {
        background-color: #2d2d3f;
    }

    @media (max-width: 1200px) {
        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<main id="main" class="main">
    <div class="container mt-6">
        <!-- Summary Cards -->
        <div class="summary-grid">
            <div class="summary-box">
                <div class="summary-value">{{ statistics.total }}</div>
                <div class="summary-label">Total</div>
            </div>
            <div class="summary-box pending">
                <div class="summary-value">{{ statistics.by_status['en attente'] ?? 0 }}</div>
                <div class="summary-label">⧖ En Attente</div>
            </div>
            <div class="summary-box confirmed">
                <div class="summary-value">{{ statistics.by_status['confirmé'] ?? 0 }}</div>
                <div class="summary-label">✓ Confirmées</div>
            </div>
            <div class="summary-box cancelled">
                <div class="summary-value">{{ statistics.by_status['annulé'] ?? 0 }}</div>
                <div class="summary-label">✗ Annulées</div>
            </div>
        </div>

        <!-- Status Chart -->
        <div class="row">
            <div class="col-lg-8 col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">📊 Répartition par Statut</h5>
                        <div class="chart-container">
                            <canvas id="statusChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Breakdown Table -->
            <div class="col-lg-4 col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">📋 Détails</h5>
                        <div class="table-responsive">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Statut</th>
                                        <th style="text-align: right;">Nombre</th>
                                        <th style="text-align: right;">%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for status, count in statistics.by_status %}
                                        <tr>
                                            <td>
                                                {% if status == 'en attente' %}
                                                    ⧖ En attente
                                                {% elseif status == 'confirmé' %}
                                                    ✓ Confirmée
                                                {% elseif status == 'annulé' %}
                                                    ✗ Annulée
                                                {% endif %}
                                            </td>
                                            <td style="text-align: right; font-weight: 600;">{{ count }}</td>
                                            <td style="text-align: right;">{{ (count / statistics.total * 100)|round(1) }}%</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Psychologist Chart (Admin Only) -->
        {% if statistics.by_psychologist|length > 0 %}
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">👨‍⚕️ Réservations par Psychologue</h5>
                        <div class="chart-container">
                            <canvas id="psychologistChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Download Options -->
       
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Chart.js dark mode colors
    const chartTextColor = '#ccc';
    const chartGridColor = '#3d3d50';

    // Status Chart
    var ctxStatus = document.getElementById('statusChart').getContext('2d');
    var statusChart = new Chart(ctxStatus, {
        type: 'doughnut',
        data: {
            labels: [
                '⧖ En attente',
                '✓ Confirmées',
                '✗ Annulées'
            ],
            datasets: [{
                data: [
                    {{ statistics.by_status['en attente'] ?? 0 }},
                    {{ statistics.by_status['confirmé'] ?? 0 }},
                    {{ statistics.by_status['annulé'] ?? 0 }}
                ],
                backgroundColor: [
                    'rgba(245, 158, 11, 0.8)',
                    'rgba(16, 185, 129, 0.8)',
                    'rgba(239, 68, 68, 0.8)'
                ],
                borderColor: [
                    'rgba(245, 158, 11, 1)',
                    'rgba(16, 185, 129, 1)',
                    'rgba(239, 68, 68, 1)'
                ],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        font: {
                            size: 14,
                            weight: 'bold'
                        },
                        color: chartTextColor,
                        padding: 20
                    }
                }
            }
        }
    });

    {% if statistics.by_psychologist|length > 0 %}
    // Psychologist Chart
    var ctxPsychologist = document.getElementById('psychologistChart').getContext('2d');
    var psychologistChart = new Chart(ctxPsychologist, {
        type: 'bar',
        data: {
            labels: [{% for psychologist, count in statistics.by_psychologist %}
                'Dr. {{ psychologist }}',
            {% endfor %}],
            datasets: [{
                label: 'Réservations',
                data: [{% for psychologist, count in statistics.by_psychologist %}{{ count }},{% endfor %}],
                backgroundColor: 'rgba(102, 126, 234, 0.8)',
                borderColor: 'rgba(102, 126, 234, 1)',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        font: { size: 12 },
                        color: chartTextColor
                    },
                    grid: {
                        color: chartGridColor
                    }
                },
                x: {
                    ticks: {
                        font: { size: 12 },
                        color: chartTextColor
                    },
                    grid: {
                        color: chartGridColor
                    }
                }
            },
            plugins: {
                legend: {
                    labels: {
                        font: { size: 14, weight: 'bold' },
                        color: chartTextColor
                    }
                }
            }
        }
    });
    {% endif %}
</script>
{% endblock %}
