{% extends 'base1.html.twig' %}

{% block title %}PsyDesk Admin - Nouvelle réservation{% endblock %}

{% block page_title %}Créer une réservation{% endblock %}
{% block page_subtitle %}Ajoutez une nouvelle réservation dans le système{% endblock %}

{% block page_header_action %}
    <a href="{{ path('app_reservation_back_index') }}" class="btn btn-sm btn-secondary">
        ← Retour à la liste
    </a>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card border-0 shadow">
                <div class="card-body">
                    <h4 class="card-title mb-4 text-white">Nouvelle réservation</h4>

                    {{ include('reservation_back/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}