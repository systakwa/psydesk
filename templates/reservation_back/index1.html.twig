{% extends 'base.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    <h1>Reservation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>IdPatient</th>
                <th>IdPsychologue</th>
                <th>DatePrevue</th>
                <th>DateDispo</th>
                <th>Status</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.idPatient }}</td>
                <td>{{ reservation.idPsychologue }}</td>
                <td>{{ reservation.datePrevue ? reservation.datePrevue|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ reservation.dateDispo ? reservation.dateDispo|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ reservation.status }}</td>
                <td>
                    <a href="{{ path('app_reservation_back_show', {'id': reservation.id}) }}">show</a>
                    <a href="{{ path('app_reservation_back_edit', {'id': reservation.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_reservation_back_new') }}">Create new</a>
{% endblock %}
