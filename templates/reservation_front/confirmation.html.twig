{% extends 'base_front.html.twig' %}
{% block title %}Réservation confirmée — PsyDesk{% endblock %}

{% block extra_styles %}
@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes popIn {
    0% {
        transform: scale(0) rotate(-45deg);
        opacity: 0;
    }
    50% {
        transform: scale(1.15) rotate(10deg);
    }
    100% {
        transform: scale(1) rotate(0deg);
        opacity: 1;
    }
}

@keyframes pulse {
    0%, 100% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    50% {
        box-shadow: 0 0 0 15px rgba(34, 197, 94, 0);
    }
}

.success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    border-radius: 50%;
    color: white;
    font-size: 3.5rem;
    line-height: 1;
    animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both,
              pulse 2s infinite;
    margin: 0 auto;
    box-shadow: 0 8px 30px rgba(34, 197, 94, 0.3);
}

.success-message {
    animation: slideDown 0.7s ease-out both;
    animation-delay: 0.3s;
}
{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container px-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5 text-center">

                {# ── Success icon ── #}
                <div class="success-icon mb-4">✓</div>

                
                <div class="success-message">
                    <h1 class="display-6 fw-bolder mb-1">
                        <span class="text-gradient">Réservation confirmée !</span>
                    </h1>
                    <p class="text-muted mb-5">Votre séance a été enregistrée avec succès.</p>
                </div>

                {# ── Details card ── #}
                <div class="card border-0 shadow rounded-4 mb-4 text-start overflow-hidden">
                    <div class="card-header bg-success text-white text-center py-3 fw-semibold">
                        <i class="bi bi-check2-circle me-2"></i>
                        En attente de confirmation du psychologue
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between px-4 py-3">
                                <span class="text-muted small"><i class="bi bi-hash me-2 text-primary"></i>N° réservation</span>
                                <span class="fw-bold">#{{ reservation.id }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-4 py-3">
                                <span class="text-muted small"><i class="bi bi-person-badge me-2 text-primary"></i>Psychologue</span>
                                <span class="fw-semibold">
                                    Dr. {{ psychologue ? psychologue.prenom ~ ' ' ~ psychologue.nom : '—' }}
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-4 py-3">
                                <span class="text-muted small"><i class="bi bi-calendar-date me-2 text-primary"></i>Date</span>
                                <span class="fw-semibold">
                                    {{ reservation.datePrevue ? reservation.datePrevue|date('d/m/Y') : '—' }}
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-4 py-3">
                                <span class="text-muted small"><i class="bi bi-clock me-2 text-primary"></i>Heure</span>
                                <span class="fw-semibold">
                                    {{ reservation.datePrevue ? reservation.datePrevue|date('H:i') : '—' }}
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-4 py-3">
                                <span class="text-muted small"><i class="bi bi-info-circle me-2 text-primary"></i>Statut</span>
                                <span class="badge bg-warning text-dark fw-semibold">{{ reservation.status }}</span>
                            </li>
                        </ul>
                    </div>
                </div>

                {# ── Email notice ── #}
                <div class="alert alert-info rounded-3 small d-flex gap-2 align-items-start text-start mb-4">
                    <i class="bi bi-envelope-check-fill flex-shrink-0 mt-1"></i>
                    <span>Un email de confirmation a été envoyé à votre adresse. Vérifiez également vos spams.</span>
                </div>

                {# ── Actions ── #}
                <div class="d-flex flex-column gap-2">
                    <a href="{{ path('app_reservation_front_my_reservations') }}"
                       class="btn btn-primary btn-lg fw-bolder py-3">
                        <i class="bi bi-list-check me-2"></i>Voir mes réservations
                    </a>
                    <a href="{{ path('app_reservation_front_index') }}"
                       class="btn btn-outline-secondary py-2">
                        <i class="bi bi-arrow-left me-1"></i>Retour aux psychologues
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}
