{% extends 'base_front.html.twig' %}
{% block title %}Confirmer la réservation — PsyDesk{% endblock %}

{% block page_hero %}
<section class="py-4 bg-white border-bottom">
    <div class="container px-5">
        <a href="javascript:history.back()"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour aux créneaux
        </a>
    </div>
</section>
{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container px-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">

                <div class="text-center mb-4">
                    <h1 class="display-6 fw-bolder mb-1">
                        <span class="text-gradient">Confirmer votre réservation</span>
                    </h1>
                    <p class="text-muted">Vérifiez les informations avant de valider</p>
                </div>

                {# ── Summary card ── #}
                <div class="card border-0 shadow rounded-4 mb-4 overflow-hidden">
                    <div class="card-header bg-gradient-primary-to-secondary text-white text-center py-4">
                        <div class="display-4 mb-1">📋</div>
                        <div class="fw-semibold">Récapitulatif du rendez-vous</div>
                    </div>
                    <div class="card-body p-4">

                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-3">
                            <div style="width:48px;height:48px;border-radius:50%;
                                        background:linear-gradient(135deg,#0d6efd,#6610f2);
                                        display:flex;align-items:center;justify-content:center;
                                        font-size:16px;font-weight:700;color:#fff;flex-shrink:0;">
                                {{ psychologue.prenom|first|upper }}{{ psychologue.nom|first|upper }}
                            </div>
                            <div>
                                <div class="small text-muted">Psychologue</div>
                                <div class="fw-bolder">Dr. {{ psychologue.prenom }} {{ psychologue.nom }}</div>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush rounded-3 mb-0">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-3">
                                <span class="text-muted small"><i class="bi bi-calendar-date me-2 text-primary"></i>Date</span>
                                <span class="fw-semibold">{{ slotTime|date('l d F Y')|capitalize }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-3">
                                <span class="text-muted small"><i class="bi bi-clock me-2 text-primary"></i>Heure</span>
                                <span class="fw-semibold">{{ slotTime|date('H:i') }}</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-3">
                                <span class="text-muted small"><i class="bi bi-envelope me-2 text-primary"></i>Email psychologue</span>
                                <span class="fw-semibold small">{{ psychologue.email }}</span>
                            </li>
                        </ul>
                    </div>
                </div>

                {# ── Warning ── #}
                <div class="alert alert-warning rounded-3 small d-flex gap-2 align-items-start mb-4">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                    <span>
                        En confirmant, ce créneau sera <strong>immédiatement réservé</strong> et ne sera plus accessible
                        aux autres patients. Un email de confirmation vous sera envoyé.
                    </span>
                </div>

                {# ── Actions ── #}
                <div class="d-flex gap-3">
                    <a href="javascript:history.back()"
                       class="btn btn-outline-secondary flex-fill py-3 fw-semibold">
                        <i class="bi bi-x-lg me-1"></i>Annuler
                    </a>
                    <form method="POST"
                          action="{{ path('app_reservation_front_book', {'psychologueId': psychologue.id, 'slotDateTime': slotDateTime}) }}"
                          class="flex-fill">
                        <button type="submit" class="btn btn-primary w-100 py-3 fw-bolder">
                            <i class="bi bi-check-circle-fill me-2"></i>Confirmer la réservation
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}
