{% extends 'base_front.html.twig' %}

{% block title %}Réserver une séance - PsyDesk{% endblock %}

{% block extra_styles %}
.psycho-card {
    transition: opacity 0.3s ease, transform 0.2s ease;
}
.psycho-card:hover {
    transform: translateY(-5px);
}
{% endblock %}

{% block page_hero %}
<section class="py-5 bg-gradient-primary-to-secondary text-white">
    <div class="container px-5 text-center">
        <h1 class="display-5 fw-bolder mb-2"> Trouver votre psychologue</h1>
        <p class="lead mb-0 opacity-75">Sélectionnez un psychologue et choisissez votre créneau</p>
    </div>
</section>
{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container px-5">

        {# Search Bar #}
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <div class="card border-0 shadow rounded-4 p-4">
                    <form method="POST" id="searchForm">
                        <input type="text" id="psychoSearch" name="search" class="form-control form-control-lg"
                               placeholder="Rechercher par nom, prénom ou email..." value="{{ search }}">
                    </form>
                </div>
            </div>
        </div>

        {# Results Header #}
        <div class="d-flex align-items-center mb-4">
            <h5 class="fw-semibold mb-0">
                <span class="text-gradient" id="resultCount">{{ psychologues|length }}</span>
                psychologue{{ psychologues|length != 1 ? 's' : '' }} disponible{{ psychologues|length != 1 ? 's' : '' }}
            </h5>
            {% if search %}
                <span class="badge bg-primary ms-2">{{ search }}</span>
            {% endif %}
        </div>

        {# Grid #}
        <div class="row gx-4 gy-4" id="psychoList">
            {% if psychologues|length == 0 %}
                <div class="col-12">
                    <div class="text-center py-5">
                        <div class="display-1 mb-3">🔍</div>
                        <h4 class="fw-semibold">Aucun psychologue trouvé</h4>
                        <p class="text-muted">Essayez de modifier vote recherche.</p>
                    </div>
                </div>
            {% else %}
                {% for psy in psychologues %}
                    <div class="col-md-6 col-xl-4 psycho-card">
                        <a href="{{ path('app_reservation_front_select', {'id': psy.id}) }}"
                           class="card border-0 shadow rounded-4 h-100 text-decoration-none text-dark">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="psy-avatar" style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #0d6efd, #6610f2); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: #fff;">
                                        {{ psy.prenom|first|upper }}{{ psy.nom|first|upper }}
                                    </div>
                                    <div>
                                        <div class="fw-bolder fs-6 lh-sm">Dr. {{ psy.prenom }} {{ psy.nom }}</div>
                                        <div class="small text-primary fw-semibold">Psychologue</div>
                                    </div>
                                </div>
                                <ul class="list-unstyled mb-3 small text-muted">
                                    <li class="mb-1"><i class="bi bi-envelope me-2 text-primary"></i>{{ psy.email }}</li>
                                </ul>
                            </div>
                            <div class="card-footer bg-transparent border-top d-flex align-items-center justify-content-between px-4 py-3">
                                <span class="badge bg-success-subtle text-success fw-semibold">
                                    <i class="bi bi-circle-fill me-1" style="font-size:.5rem;vertical-align:middle;"></i>Disponible
                                </span>
                                <span class="small text-primary fw-semibold">
                                    Réserver <i class="bi bi-arrow-right ms-1"></i>
                                </span>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

    </div>
</section>
{% endblock %}

{% block cta_section %}
<section class="py-5 bg-gradient-primary-to-secondary text-white">
    <div class="container px-5 text-center">
        <h2 class="display-6 fw-bolder mb-3">Déjà réservé une séance ?</h2>
        <a class="btn btn-outline-light btn-lg px-5 py-3 fs-6 fw-bolder"
           href="{{ path('app_reservation_front_my_reservations') }}">
            <i class="bi bi-list-check me-2"></i>Voir mes réservations
        </a>
    </div>
</section>
{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
    $("#psychoSearch").on("keyup", function() {
        var searchQuery = $(this).val().toLowerCase();
        var count = 0;

        $(".psycho-card").each(function() {
            var visible = $(this).text().toLowerCase().indexOf(searchQuery) > -1;
            $(this).toggle(visible);
            if (visible) count++;
        });

        // Update count
        $("#resultCount").text(count);
    });
});
</script>
{% endblock %}

