{% extends 'base.html.twig' %}

{% block title %}PsyDesk Admin - Réclamations{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card corona-gradient-card">
                <div class="card-body py-0 px-0 px-sm-3">
                    <div class="row align-items-center">
                        <div class="col-4 col-sm-3 col-xl-2">
                            <img src="{{ asset('assets/images/dashboard/Group126@2x.png') }}" class="gradient-corona-img img-fluid" alt="">
                        </div>
                        <div class="col-5 col-sm-7 col-xl-8 p-0">
                            <h4 class="mb-1 mb-sm-0">Gestion des réclamations</h4>
                            <p class="mb-0 font-weight-normal d-none d-sm-block">Consultez et gérez toutes les réclamations des patients.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="row">
        <div class="col-12 grid-margin">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Liste des réclamations</h4>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Patient</th>
                                    <th>Description</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                <tr>
                                    <td>{{ reclamation.id }}</td>
                                    <td>{{ reclamation.idPatient.fullName }}<br>
                                        <small class="text-muted">{{ reclamation.idPatient.email }}</small>
                                    </td>
                                    <td>{{ reclamation.description }}</td>
                                    <td>{{ reclamation.date ? reclamation.date|date('d/m/Y') : '' }}</td>
                                    <td>
                                        {% if reclamation.status == 'pending' %}
                                            <span class="badge bg-warning text-dark">🕐 En attente</span>
                                        {% elseif reclamation.status == 'grave' %}
                                            <span class="badge bg-danger">⚠️ Grave</span>
                                        {% else %}
                                            <span class="badge bg-success">✅ Traité</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if reclamation.status == 'pending' %}
                                            <form method="post" action="{{ path('app_reclamation_ban', {'id': reclamation.id}) }}" style="display: inline-block;" 
                                                  onsubmit="return confirm('⚠️ Désactiver définitivement {{ reclamation.idPatient.fullName }} ?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('ban' ~ reclamation.id) }}">
                                                <input type="hidden" name="reason" value="Réclamation grave: {{ reclamation.description|slice(0, 100) }}">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    🔒 Bannir
                                                </button>
                                            </form>
                                            
                                            <form method="post" action="{{ path('app_reclamation_ignore', {'id': reclamation.id}) }}" style="display: inline-block;" 
                                                  onsubmit="return confirm('Ignorer cette réclamation ?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('ignore' ~ reclamation.id) }}">
                                                <button type="submit" class="btn btn-secondary btn-sm">
                                                    ✅ Ignorer
                                                </button>
                                            </form>
                                        {% elseif reclamation.status == 'grave' %}
                                            <span class="text-danger">⚠️ Utilisateur banni</span>
                                            <br><small class="text-muted">{{ reclamation.idPatient.banReason|slice(0, 50) }}...</small>
                                        {% else %}
                                            <span class="text-muted">✓ Traité le {{ reclamation.processedAt|date('d/m/Y') }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center">Aucune réclamation trouvée.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}