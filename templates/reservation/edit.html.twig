{% extends 'dashboard.html.twig' %}

{% block title %}Modifier Réservation{% endblock %}

{% block body %}

<div class="card mt-5">
    <div class="card-header">
        <h4 class="header-title">Modifier la réservation</h4>
        <p class="text-muted mb-0">
            Modifiez les informations de votre réservation.
        </p>
    </div>

    <div class="card-body">

        {{ form_start(form) }}

        <div class="row">

            <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label">Date prévue</label>
                    {{ form_widget(form.date_prevue, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>

            <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label">Psychologue</label>
                    {{ form_widget(form.psychologue, {'attr': {'class': 'form-select'}}) }}
                </div>
            </div>

        </div>

        <button class="btn btn-primary">
            Mettre à jour
        </button>

        <a href="{{ path('patient_reservation_list') }}" class="btn btn-secondary">
            Retour à la liste
        </a>

        {{ form_end(form) }}

    </div>
</div>

{% endblock %}