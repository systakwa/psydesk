{% extends 'dashboard.html.twig' %}

{% block body %}

<div class="card">
    <div class="card-header">
        <h4 class="header-title">Créer une réservation</h4>
        <p class="text-muted mb-0">
            Veuillez remplir les informations ci-dessous pour effectuer une réservation.
        </p>
    </div>

    <div class="card-body">

        {{ form_start(form) }}

        <div class="row">

            <div class="col-lg-6">

                <div class="mb-3">
                    <label class="form-label">Date prévue</label>
                    {{ form_widget(form.date_prevue, {'attr': {'class': 'form-control'}}) }}
                </div>

            </div>

            <div class="col-lg-6">

                <div class="mb-3">
                    <label class="form-label">Psychologue</label>
                    {{ form_widget(form.psychologue, {'attr': {'class': 'form-select'}}) }}
                </div>

            </div>

        </div>

        <button class="btn btn-primary mt-2">
            Enregistrer
        </button>

        {{ form_end(form) }}

    </div>
</div>

{% endblock %}