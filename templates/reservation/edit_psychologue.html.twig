{% extends 'dashboard.html.twig' %}

{% block title %}Confirmer Reservation{% endblock %}

{% block body %}

<div class="card mt-5">
    <div class="card-header">
        <h4 class="header-title">Confirmer la réservation</h4>
    </div>

    <div class="card-body">

        <h5>Informations du patient</h5>
        <p><strong>Patient:</strong> {{ reservation.patient.email }}</p>
        <p><strong>Date choisie par le patient:</strong> {{ reservation.datePrevue|date('Y-m-d H:i') }}</p>

        {{ form_start(form) }}

<div class="mb-3">
    {{ form_label(form.date_dispo) }}
    {{ form_widget(form.date_dispo, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.date_dispo) }}
</div>

<div class="mb-3">
    {{ form_label(form.texteFiche) }}
    {{ form_widget(form.texteFiche, {'attr': {'class': 'form-control'}}) }}

    <div class="text-danger">
        {{ form_errors(form.texteFiche) }}
    </div>
</div>

<button class="btn btn-primary">Confirmer la réservation</button>
<a href="{{ path('psychologue_reservations') }}" class="btn btn-secondary">Retour</a>

{{ form_end(form) }}

    </div>
</div>

{% endblock %}