{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="form-group">
        {{ form_label(form.description) }}
        {{ form_widget(form.description) }}
        {{ form_errors(form.description) }}
        <small class="form-text text-muted">Maximum 100 caractères.</small>
    </div>

    <div class="form-group">
        {{ form_label(form.datefin) }}
        {{ form_widget(form.datefin) }}
        {{ form_errors(form.datefin) }}
        <small class="form-text text-muted">Doit être supérieure ou égale à aujourd'hui.</small>
    </div>

    {{ form_row(form.status) }}
    {{ form_row(form.nb_note) }}
    {{ form_row(form.nb_jour) }}
    {{ form_row(form.created_at) }}
    {{ form_row(form.etat) }}
    {{ form_row(form.idPatient) }}

    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}