{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="form-group">
        {{ form_label(form.texteNote) }}
        {{ form_widget(form.texteNote) }}
        {{ form_errors(form.texteNote) }}
        <small class="form-text text-muted">Minimum 5 caractères.</small>
    </div>

    <div class="form-group">
        {{ form_label(form.date) }}
        {{ form_widget(form.date) }}
        {{ form_errors(form.date) }}
        <small class="form-text text-muted">Date de la note (ne peut pas être dans le futur).</small>
    </div>

    <div class="form-group">
        {{ form_label(form.evaluation) }}
        {{ form_widget(form.evaluation) }}
        {{ form_errors(form.evaluation) }}
    </div>

    <div class="form-group">
        {{ form_label(form.satisfer) }}
        {{ form_widget(form.satisfer) }}
        {{ form_errors(form.satisfer) }}
        <small class="form-text text-muted">Entre 0 et 10.</small>
    </div>

   
    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}