<form method="post" action="{{ path('app_planning_back_delete', {'id': planning.id}) }}" 
      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce planning ? Cette action est irréversible.');" 
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ planning.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>