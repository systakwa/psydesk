{% extends 'base.admin.html.twig' %}

{% block title %}Evenement index{% endblock %}

{% block body %}

<!-- SECTION EVENTS -->
<section class="bg-light py-5">
    <div class="container px-5">

        <!-- TITLE -->
        <div class="text-center mb-5">
            <h1 class="fw-bolder">Nos événements</h1>
            <p class="lead text-muted">Découvrez et participez à nos événements</p>
        </div>

        <!-- FLASH MESSAGES -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <!-- SEARCH -->
        <form method="get" class="mb-4">
            <input type="text" name="q" class="form-control" placeholder="Rechercher événement...">
        </form>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Titre</th>
                        <th>
                            <a href="?sort=date" class="text-white text-decoration-none">Date</a>
                        </th>
                        <th>Lieu</th>
                        <th>Type</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                {% for evenement in evenements %}
                    <tr>
                        <td class="fw-bold">{{ evenement.titre }}</td>
                        <td>{{ evenement.dateEvent ? evenement.dateEvent|date('Y-m-d') : '' }}</td>
                        <td>{{ evenement.lieu }}</td>
                        <td>{{ evenement.type }}</td>
                        <td>
                            <span class="badge bg-secondary">{{ evenement.statut }}</span>
                        </td>
                        <td class="text-center">
                            <a href="{{ path('admin_event_show', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-primary">Show</a>

                            <a href="{{ path('admin_event_edit', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-warning">Edit</a>

                            <a href="{{ path('participer_event', {'id': evenement.id}) }}" class="btn btn-sm btn-success">
                                Participer
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">Aucun événement</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- BUTTON -->
        <div class="text-center mt-4">
            <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
                Créer un événement
            </a>
        </div>

    </div>
</section>

{% endblock %}