{% extends 'base.admin.html.twig' %}

{% block body %}

<h2>Articles</h2>

<form method="get">
    <input name="q" placeholder="Recherche">
    <select name="status">
        <option value="">Tous</option>
        <option value="valide">Validé</option>
        <option value="refuse">Refusé</option>
    </select>
    <button>Filtrer</button>
</form>

<table class="table">
<tr>
    <th>ID</th>
    <th>Contenu</th>
    <th>Image</th>
    <th>Statut</th>
    <th>Actions</th>
</tr>

{% for article in articles %}
<tr>
    <td>{{ article.id }}</td>
    <td>{{ article.contenu }}</td>

    <td>
        {% if article.image %}
            <img src="{{ asset('uploads/' ~ article.image) }}" width="80">
        {% endif %}
    </td>

    <td>
        <span class="badge bg-secondary">{{ article.statut }}</span>
    </td>

    <td>
        <!-- EDIT -->
        <a href="{{ path('admin_article_edit', {'id': article.id}) }}" class="btn btn-warning btn-sm">Edit</a>

        <!-- DELETE -->
        <form method="post" action="{{ path('admin_article_delete', {'id': article.id}) }}" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
            <button class="btn btn-danger btn-sm">Delete</button>
        </form>

        <!-- VALIDER -->
        <a href="{{ path('admin_article_valider', {'id': article.id}) }}" class="btn btn-success btn-sm">✔</a>

        <!-- REFUSER -->
        <a href="{{ path('admin_article_refuser', {'id': article.id}) }}" class="btn btn-dark btn-sm">✖</a>
    </td>

</tr>
{% endfor %}
</table>

<a href="{{ path('admin_article_new') }}" class="btn btn-dark btn-sm">Ajouter</a>

{% endblock %}