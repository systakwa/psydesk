{# templates/admin/dashboard.html.twig #}

{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}

<div class="row">

    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <h4 class="mb-0">Events</h4>
                    <i class="mdi mdi-calendar text-primary"></i>
                </div>

                <h2 class="mt-3">120</h2>
                <p class="text-muted">Total Events</p>

            </div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">

                <div class="d-flex justify-content-between">
                    <h4 class="mb-0">Articles</h4>
                    <i class="mdi mdi-file-document text-success"></i>
                </div>

                <h2 class="mt-3">80</h2>
                <p class="text-muted">Total Articles</p>

            </div>
        </div>
    </div>

</div>

<div class="row mt-4">

    <div class="col-12 grid-margin">
        <div class="card">
            <div class="card-body">

                <h4 class="card-title">Recent Activity</h4>

                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Sample Event</td>
                            <td><span class="badge badge-success">Active</span></td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>Sample Article</td>
                            <td><span class="badge badge-warning">Pending</span></td>
                        </tr>
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>

{% endblock %}