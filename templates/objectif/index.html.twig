

{% block title %}Objectif index{% endblock %}

{% block body %}
    <h1>Objectif index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Decription</th>
                <th>Datefin</th>
                <th>Status</th>
                <th>Nb_note</th>
                <th>Nb_jour</th>
                <th>Created_at</th>
                <th>Etat</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for objectif in objectifs %}
            <tr>
                <td>{{ objectif.id }}</td>
                <td>{{ objectif.description }}</td>
                <td>{{ objectif.datefin ? objectif.datefin|date('Y-m-d') : '' }}</td>
                <td>{{ objectif.status ? 'Yes' : 'No' }}</td>
                <td>{{ objectif.nbNote }}</td>
                <td>{{ objectif.nbJour }}</td>
                <td>{{ objectif.createdAt ? objectif.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ objectif.etat ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_objectif_show', {'id': objectif.id}) }}">show</a>
                    <a href="{{ path('app_objectif_edit', {'id': objectif.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_objectif_new') }}">Create new</a>
{% endblock %}
