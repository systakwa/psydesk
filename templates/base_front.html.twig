<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="PsyDesk - Plateforme de gestion des rendez-vous psychologiques" />
    <title>{% block title %}PsyDesk{% endblock %}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Core theme CSS -->
    <link href="/assets/css/styles.css" rel="stylesheet" />

    <style>
        /* ── Global Styles ── */
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* ── Navbar Styling ── */
        .navbar {
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
            transition: all 0.2s;
        }

        .navbar-nav .nav-link {
            font-weight: 600;
            padding: 0.5rem 1rem !important;
            border-radius: 40px;
            transition: 0.2s;
        }

        .navbar-nav .nav-link:hover {
            background: #f1f5f9;
            color: #667eea !important;
        }

        .navbar-nav .nav-link.active {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white !important;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f8fafc;
            padding: 6px 14px;
            border-radius: 40px;
            margin-left: 1rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: #1e293b;
        }

        .user-info i {
            font-size: 1.2rem;
            color: #667eea;
        }

        /* Gradient text utility */
        .text-gradient {
            background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Gradient section */
        .bg-gradient-primary-to-secondary {
            background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%) !important;
        }

        /* ── Flash Messages ── */
        .alert {
            border-radius: 0.5rem;
            border: none;
            padding: 1rem 1.25rem;
            margin-bottom: 1rem;
        }

        .flash-success {
            background: #d1fae5;
            border-left: 4px solid #10b981;
            color: #065f46;
        }

        .flash-error {
            background: #fee2e2;
            border-left: 4px solid #ef4444;
            color: #991b1b;
        }

        .flash-warning {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            color: #92400e;
        }

        .flash-info {
            background: #dbeafe;
            border-left: 4px solid #3b82f6;
            color: #1e40af;
        }

        /* ── Responsive ── */
        @media (max-width: 991.98px) {
            .user-info {
                margin-left: 0;
                margin-top: 10px;
                justify-content: center;
            }
        }

        {% block extra_styles %}{% endblock %}
    </style>
</head>

<body class="d-flex flex-column h-100">

    <!-- ══ Navigation ══ -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
        <div class="container px-5">
            <a class="navbar-brand" href="{{ path('app_patient_dashboard') }}">
                <span class="fw-bolder text-primary">PsyDesk</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 small fw-bolder align-items-center">
                            <li class="nav-item"><a class="nav-link active" href="#">Home</a></li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_reservation_front' %}active{% endif %}"
                           href="{{ path('app_reservation_front_index') }}">
                            Réservations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_reservation_front_my_reservations' %}active{% endif %}"
                           href="{{ path('app_reservation_front_my_reservations') }}">
                            Mes rendez-vous
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_objectif' %}active{% endif %}"
                           href="{{ path('app_objectif_index') }}">
                            Mes objectifs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_reclamation' %}active{% endif %}"
                           href="{{ path('app_reclamation_index') }}">
                            Réclamations
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="{{ path('app_logout') }}">
                            Déconnexion
                        </a>
                    </li>
                    {% if app.user %}
                    <li class="nav-item">
                        <div class="user-info">
                            <i class="bi bi-person-circle"></i>
                            <span>{{ app.user.prenom ?? 'Utilisateur' }} {{ app.user.nom ?? '' }}</span>
                        </div>
                    </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <!-- ══ Flash Messages ══ -->
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="container px-5 mt-3">
                <div class="alert flash-{{ type }} alert-dismissible fade show" role="alert">
                    {% if type == 'success' %}
                        <i class="bi bi-check-circle me-2"></i>
                    {% elseif type == 'error' %}
                        <i class="bi bi-exclamation-circle me-2"></i>
                    {% elseif type == 'warning' %}
                        <i class="bi bi-exclamation-triangle me-2"></i>
                    {% else %}
                        <i class="bi bi-info-circle me-2"></i>
                    {% endif %}
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- ══ Page Hero (optional override) ══ -->
    {% block page_hero %}{% endblock %}

    <!-- ══ Main Content ══ -->
    <main class="flex-shrink-0">
        {% block body %}{% endblock %}
    </main>

    <!-- ══ CTA Section (optional override) ══ -->
    {% block cta_section %}{% endblock %}

    <!-- ══ Footer ══ -->
    <footer class="bg-white py-4 mt-auto border-top">
        <div class="container px-5">
            <div class="row align-items-center justify-content-between flex-column flex-sm-row">
                <div class="col-auto">
                    <div class="small text-muted m-0">&copy; 2026 PsyDesk — Plateforme de santé mentale</div>
                </div>
                <div class="col-auto">
                    <a class="small text-muted text-decoration-none" href="#!">Confidentialité</a>
                    <span class="mx-1 text-muted">&middot;</span>
                    <a class="small text-muted text-decoration-none" href="#!">Conditions</a>
                    <span class="mx-1 text-muted">&middot;</span>
                    <a class="small text-muted text-decoration-none" href="#!">Contact</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}

</body>
</html>
