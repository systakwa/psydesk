{% extends 'base.html.twig' %}

{% block title %}Article{% endblock %}

{% block body %}
    <h1>Article</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article.id }}</td>
            </tr>
            <tr>
                <th>Contenu</th>
                <td>{{ article.contenu }}</td>
            </tr>
            <tr>
                <th>ImageUrl</th>
                <td>{{ article.imageUrl }}</td>
            </tr>
            <tr>
                <th>VideoUrl</th>
                <td>{{ article.VideoUrl }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ article.statut }}</td>
            </tr>
            <tr>
                <th>DatePost</th>
                <td>{{ article.datePost ? article.datePost|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UserEmail</th>
                <td>{{ article.userEmail }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_article_index') }}">back to list</a>

    <a href="{{ path('app_article_edit', {'id': article.id}) }}">edit</a>

    {{ include('article/_delete_form.html.twig') }}
{% endblock %}
