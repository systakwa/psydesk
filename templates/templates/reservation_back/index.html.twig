{% extends 'base1.html.twig' %}

{% block title %}PsyDesk Admin - Réservations{% endblock %}

{% block page_title %}Gestion des réservations{% endblock %}
{% block page_subtitle %}Consultez et gérez toutes les réservations des patients.{% endblock %}

{% block page_header_action %}
<style>
.action-buttons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: 100%;
}

.action-btn {
    padding: 7px 10px;
    border-radius: 8px;
    border: none;
    font-weight: 500;
    font-size: 12px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: white;
    transition: opacity 0.2s ease;
    width: 100%;
}

.action-btn:hover {
    opacity: 0.85;
    color: white;
    text-decoration: none;
}

.btn-calendar { background: #2563eb; }
.btn-stats    { background: #059669; }
.btn-pdf      { background: #dc2626; }
.btn-excel    { background: #d97706; }
.btn-new      { background: #db2777; }

@media (max-width: 768px) {
    .action-buttons {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>

<div class="action-buttons">
    <a href="{{ path('app_reservation_back_calendar') }}" class="action-btn btn-calendar">
        <i class="bi bi-calendar3"></i> Calendrier
    </a>
    <a href="{{ path('app_reservation_back_stat') }}" class="action-btn btn-stats">
        <i class="bi bi-bar-chart"></i> Stats
    </a>
    <a href="{{ path('app_reservation_back_pdf_all') }}" class="action-btn btn-pdf">
        <i class="bi bi-file-pdf"></i> PDF
    </a>
    <a href="{{ path('app_reservation_back_excel') }}" class="action-btn btn-excel">
        <i class="bi bi-file-earmark-spreadsheet"></i> Excel
    </a>
    <a href="{{ path('app_reservation_back_new') }}" class="action-btn btn-new">
        <i class="bi bi-plus-circle"></i> Nouvelle
    </a>
</div>
 
{% endblock %}

{% block body %}
<style>
#statusFilter {
    border: 2px solid #e0e0e0;
    border-radius: 0.375rem;
    font-weight: 500;
    transition: all 0.2s ease;
}

#statusFilter:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    outline: none;
}

#statusFilter option {
    padding: 8px 12px;
    font-weight: 500;
}

#statusFilter option[value=""] {
    color: #6c757d;
}

#statusFilter option[value="en attente"] {
    color: #f59e0b;
}

#statusFilter option[value="confirmé"] {
    color: #10b981;
}

#statusFilter option[value="annulé"] {
    color: #ef4444;
}

.badge {
    background: transparent !important;
    padding: 0.25rem 0.5rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.badge.bg-success {
    color: #10b981 !important;
}

.badge.bg-warning {
    color: #f59e0b !important;
}

.badge.bg-danger {
    color: #dc2626 !important;
}

.pagination {
    justify-content: center !important;
    gap: 8px;
}

.pagination .page-item .page-link {
    background-color: #1e1e2f !important;
    color: #cbd5e1 !important;
    border: 1px solid #2d2d44 !important;
    border-radius: 10px !important;
    padding: 6px 14px;
    transition: all 0.25s ease;
}

.pagination .page-item .page-link:hover {
    background-color: #0d6efd !important;
    color: #fff !important;
    border-color: #0d6efd !important;
    transform: scale(1.1);
}

.pagination .page-item.active .page-link {
    background: linear-gradient(135deg, #0d6efd, #3b82f6) !important;
    color: #fff !important;
    border: none !important;
    font-weight: 600;
    box-shadow: 0 0 12px rgba(13, 110, 253, 0.5);
}

.pagination .page-item.disabled .page-link {
    background-color: #151521 !important;
    color: #6c757d !important;
    border-color: #2d2d44 !important;
}
</style>

<h4 class="card-title">Liste des réservations</h4>

<div class="card mb-4">
    <div class="card-body">
        <form method="POST" id="searchForm">
            <div class="row g-3">
                <div class="col-md-8">
                    <input type="text" id="reservationSearch" name="search" class="form-control"
                           placeholder="Rechercher par nom, prénom ou email..." value="{{ search }}">
                </div>
                <div class="col-md-4">
                    <select id="statusFilter" name="status" class="form-select fw-semibold">
                        <option value=""> Tous les statuts</option>
                        <option value="en attente"> En attente</option>
                        <option value="confirmé">✓ Confirmés</option>
                        <option value="annulé">✕ Annulés</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Psychologue</th>
                <th>Date/Heure</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="reservationList">
            {% for reservation in reservations %}
            <tr class="reservation-row">
                <td>
                    {% if reservationData[reservation.id].patient %}
                        <div style="font-weight: 600;">
                            {{ reservationData[reservation.id].patient.prenom }}
                            {{ reservationData[reservation.id].patient.nom }}
                        </div>
                        <small class="text-muted">{{ reservationData[reservation.id].patient.email }}</small>
                    {% else %}
                        ID: {{ reservation.idPatient }}
                    {% endif %}
                </td>
                <td>
                    {% if reservationData[reservation.id].psychologue %}
                        <div style="font-weight: 600;">
                            Dr. {{ reservationData[reservation.id].psychologue.prenom }}
                            {{ reservationData[reservation.id].psychologue.nom }}
                        </div>
                        <small class="text-muted">{{ reservationData[reservation.id].psychologue.email }}</small>
                    {% else %}
                        ID: {{ reservation.idPsychologue }}
                    {% endif %}
                </td>
                <td>
                    <strong>{{ reservation.datePrevue|date('d/m/Y H:i') }}</strong>
                </td>
                <td>
                    {% if reservation.status == 'en attente' %}
                        <span class="badge bg-warning">
                            <i class="bi bi-clock-fill"></i> En attente
                        </span>
                    {% elseif reservation.status == 'confirmé' %}
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle-fill"></i> Confirmé
                        </span>
                    {% else %}
                        <span class="badge bg-danger">
                            <i class="bi bi-x-circle-fill"></i> Annulé
                        </span>
                    {% endif %}
                </td>
                <td>
                    {% if reservation.status == 'en attente' %}
                        <form method="POST" class="d-inline me-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ reservation.id) }}">
                            <button type="submit"
                                    formaction="{{ path('app_reservation_back_accept', {'id': reservation.id}) }}"
                                    class="btn btn-sm btn-outline-success">
                                <i class="bi bi-check-circle"></i> Accepter
                            </button>
                        </form>
                        <form method="POST" class="d-inline me-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('refuse' ~ reservation.id) }}">
                            <button type="submit"
                                    formaction="{{ path('app_reservation_back_refuse', {'id': reservation.id}) }}"
                                    class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x-circle"></i> Refuser
                            </button>
                        </form>
                    {% endif %}
                    <a href="{{ path('app_reservation_back_show', {'id': reservation.id}) }}"
                       class="btn btn-sm btn-outline-info">
                        <i class="bi bi-eye"></i> Voir
                    </a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% if reservations|length == 0 %}
    <div class="alert alert-info text-center py-4">
        <i class="bi bi-inbox fs-1 mb-2"></i>
        <p class="mb-0">Aucune réservation trouvée.</p>
    </div>
{% endif %}

<div class="mt-4">
    {{ knp_pagination_render(reservations) }}
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    $("#reservationSearch").on("keyup", function () {
        var searchQuery = $(this).val().toLowerCase();
        $(".reservation-row").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(searchQuery) > -1);
        });
    });

    $("#statusFilter").on("change", function () {
        var statusFilter = $(this).val().toLowerCase();
        if (statusFilter === '') {
            $(".reservation-row").show();
        } else {
            $(".reservation-row").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(statusFilter) > -1);
            });
        }
    });
});
</script>
{% endblock %}