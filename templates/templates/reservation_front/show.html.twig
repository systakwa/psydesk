{% extends 'base.html.twig' %}

{% block title %}Reservation{% endblock %}

{% block body %}
    <h1>Reservation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reservation.id }}</td>
            </tr>
            <tr>
                <th>IdPatient</th>
                <td>{{ reservation.idPatient }}</td>
            </tr>
            <tr>
                <th>IdPsychologue</th>
                <td>{{ reservation.idPsychologue }}</td>
            </tr>
            <tr>
                <th>DatePrevue</th>
                <td>{{ reservation.datePrevue ? reservation.datePrevue|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateDispo</th>
                <td>{{ reservation.dateDispo ? reservation.dateDispo|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ reservation.status }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reservation_front_index') }}">back to list</a>

    <a href="{{ path('app_reservation_front_edit', {'id': reservation.id}) }}">edit</a>

    {{ include('reservation_front/_delete_form.html.twig') }}
{% endblock %}
