{% extends 'base_front.html.twig' %}

{% block title %}Mes rendez-vous - PsyDesk{% endblock %}

{% block page_hero %}
<section class="py-4 bg-gradient-primary-to-secondary text-white">
    <div class="container px-5">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="display-6 fw-bolder mb-2">Mes rendez-vous</h1>
                <p class="lead mb-0 opacity-75">Gérez vos réservations</p>
            </div>
            <a href="{{ path('app_reservation_front_index') }}" class="btn btn-outline-light">
                ← Nouvelle réservation
            </a>
        </div>
    </div>
</section>
{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container px-5">
        <div class="row">
            <div class="col-lg-10 mx-auto">

                {% if reservations|length == 0 %}
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    Vous n'avez aucun rendez-vous programmé.
                </div>
                {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Date et heure</th>
                                <th>Psychologue</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in reservations %}
                            <tr>
                                <td>
                                    <strong>{{ reservation.datePrevue|date('d/m/Y H:i') }}</strong>
                                </td>
                                <td>
                                    Dr. {{ reservation.psychologue.prenom }} {{ reservation.psychologue.nom }}<br>
                                    <small class="text-muted">{{ reservation.psychologue.email }}</small>
                                </td>
                                <td>
                                    {% if reservation.status == 'confirmé' %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Confirmé
                                    </span>
                                    {% elseif reservation.status == 'en attente' %}
                                    <span class="badge bg-warning">
                                        <i class="bi bi-clock me-1"></i>En attente
                                    </span>
                                    {% else %}
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>Annulé
                                    </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if reservation.status == 'en attente' %}
                                    <form method="POST" action="{{ path('app_reservation_front_cancel', {'id': reservation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler ce rendez-vous ?');" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash me-1"></i>Annuler
                                        </button>
                                    </form>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}

            </div>
        </div>
    </div>
</section>
{% endblock %}

<style>
.table {
    background-color: #fff;
}

.table-hover tbody tr:hover {
    background-color: #f8f9fa;
}

.badge {
    font-size: 0.85rem;
    padding: 0.25rem 0.5rem;
    background: transparent !important;
}

.badge.bg-success {
    color: #10b981 !important;
}

.badge.bg-warning {
    color: #f59e0b !important;
}

.badge.bg-danger {
    color: #dc2626 !important;
}

.badge.bg-secondary {
    color: #6b7280 !important;
}

.btn-sm {
    padding: 0.375rem 0.75rem;
}
</style>
