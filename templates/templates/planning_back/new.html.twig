{% extends 'base1.html.twig' %}

{% block title %}PsyDesk Admin - Nouveau planning{% endblock %}

{% block page_title %}Créer un planning{% endblock %}
{% block page_subtitle %}Ajoutez un nouveau planning dans le système{% endblock %}

{% block page_header_action %}
    <a href="{{ path('app_planning_back_index') }}" class="btn btn-sm btn-secondary">
        ← Retour à la liste
    </a>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4">Nouveau planning</h4>
                    
                    {{ include('planning_back/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}