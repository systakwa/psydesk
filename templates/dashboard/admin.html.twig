{% extends 'base.html.twig' %}

{% block title %}Administration | PSYDESK{% endblock %}

{% block stylesheets %}
<style>
    .search-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }
    .search-input {
        flex: 1;
        padding: 12px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 14px;
        transition: all 0.3s;
    }
    .search-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.1);
    }
    .search-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s;
    }
    .search-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102,126,234,0.4);
    }
    .reset-btn {
        background: #64748b;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s;
    }
    .reset-btn:hover {
        background: #475569;
    }
    .no-result {
        text-align: center;
        padding: 40px;
        color: #64748b;
        font-size: 16px;
    }
</style>
{% endblock %}

{% block body %}
<div style="display: flex; min-height: 100vh;">
    <!-- Sidebar -->
    <div style="width: 260px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; padding: 20px;">
        <h3 style="text-align: center; margin-bottom: 30px;">⚡ Admin PSYDESK</h3>
        <div style="margin-bottom: 10px; padding: 10px; background: rgba(255,255,255,0.2); border-radius: 10px;">📊 Tableau de bord</div>
        <div style="margin-bottom: 10px; padding: 10px;">👥 Utilisateurs</div>
        <div style="margin-bottom: 10px; padding: 10px;">📈 Statistiques</div>
        <hr style="margin: 20px 0;">
        <a href="{{ path('app_logout') }}" style="color: white; text-decoration: none; display: block; padding: 10px;">🚪 Déconnexion</a>
    </div>

    <!-- Main Content -->
    <div style="flex: 1; padding: 20px; background: #f5f7fb;">
        <div style="background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px;">
            <h2>Tableau de bord</h2>
            <p>Bienvenue, <strong>{{ user.fullName }}</strong> !</p>
        </div>

        <!-- Stats -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 20px;">
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #d8afd7;" id="totalUsers">{{ users|length }}</div>
                <div>Total utilisateurs</div>
            </div>
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #d8afd7;" id="totalPatients">{{ users|filter(u => 'ROLE_PATIENT' in u.roles)|length }}</div>
                <div>Patients</div>
            </div>
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #d8afd7;" id="totalPsychologues">{{ users|filter(u => 'ROLE_PSYCHOLOGUE' in u.roles)|length }}</div>
                <div>Psychologues</div>
            </div>
            <div style="background: white; border-radius: 15px; padding: 20px; text-align: center;">
                <div style="font-size: 28px; font-weight: bold; color: #c87cb4;" id="totalAdmins">{{ users|filter(u => 'ROLE_ADMIN' in u.roles)|length }}</div>
                <div>Administrateurs</div>
            </div>
        </div>

        <!-- Messages Flash -->
        {% for message in app.flashes('success') %}
            <div style="background: #d1fae5; color: #a06f9f; padding: 12px; border-radius: 10px; margin-bottom: 20px;">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div style="background: #fee2e2; color: #d8afd7; padding: 12px; border-radius: 10px; margin-bottom: 20px;">{{ message }}</div>
        {% endfor %}

        <!-- User Table avec barre de recherche -->
        <div style="background: white; border-radius: 15px; padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h3>📋 Liste des utilisateurs</h3>
                <a href="{{ path('app_register') }}" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 8px 20px; border-radius: 8px; text-decoration: none;">+ Nouvel utilisateur</a>
            </div>
            
            <!-- Barre de recherche -->
            <div class="search-bar">
                <input type="text" id="searchInput" class="search-input" placeholder=" Rechercher par nom, prénom, email ou rôle..." autocomplete="off">
                <button id="searchBtn" class="search-btn">Rechercher</button>
                <button id="resetBtn" class="reset-btn">Réinitialiser</button>
            </div>

            <!-- Tableau des utilisateurs -->
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;" id="userTable">
                    <thead>
                        <tr style="background: #f8f9fa;">
                            <th style="padding: 12px; text-align: left;">ID</th>
                            <th style="padding: 12px; text-align: left;">Nom complet</th>
                            <th style="padding: 12px; text-align: left;">Email</th>
                            <th style="padding: 12px; text-align: left;">Âge</th>
                            <th style="padding: 12px; text-align: left;">Rôle</th>
                            <th style="padding: 12px; text-align: left;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        {% for u in users %}
                        <tr style="border-bottom: 1px solid #eee;" data-name="{{ u.fullName|lower }}" data-email="{{ u.email|lower }}" data-role="{% if 'ROLE_ADMIN' in u.roles %}admin{% elseif 'ROLE_PSYCHOLOGUE' in u.roles %}psychologue{% else %}patient{% endif %}">
                            <td style="padding: 12px;">{{ u.id }}</td>
                            <td style="padding: 12px;"><strong>{{ u.fullName }}</strong></td>
                            <td style="padding: 12px;">{{ u.email }}</td>
                            <td style="padding: 12px;">{{ u.age }} ans</td>
                            <td style="padding: 12px;">
                                {% if 'ROLE_ADMIN' in u.roles %}
                                    <span style="background: #bb85a4; color: white; padding: 5px 10px; border-radius: 20px;">Administrateur</span>
                                {% elseif 'ROLE_PSYCHOLOGUE' in u.roles %}
                                    <span style="background: #bb85a4; color: white; padding: 5px 10px; border-radius: 20px;">Psychologue</span>
                                {% else %}
                                    <span style="background: #bb85a4; color: white; padding: 5px 10px; border-radius: 20px;">Patient</span>
                                {% endif %}
                            </td>
                            <td style="padding: 12px;">
                                <a href="{{ path('app_admin_user_edit', {'id': u.id}) }}" 
                                   style="background: #cf71c9; color: white; padding: 5px 12px; border-radius: 8px; text-decoration: none; margin-right: 5px; display: inline-block;">
                                    ✏️ Modifier
                                </a>
                                {% if u.id != user.id %}
                                    <form method="post" action="{{ path('app_admin_user_delete', {'id': u.id}) }}" 
                                          style="display: inline-block;" 
                                          onsubmit="return confirm('Supprimer définitivement {{ u.fullName }} ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                                        <button type="submit" 
                                                style="background: #7f40a6; color: white; border: none; padding: 5px 12px; border-radius: 8px; cursor: pointer;">
                                             Supprimer
                                        </button>
                                    </form>
                                {% else %}
                                    <span style="background: #9ca3af; color: white; padding: 5px 12px; border-radius: 8px;">Vous</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <div id="noResult" class="no-result" style="display: none;">
                <i class="ri-search-line" style="font-size: 48px;"></i>
                <p>Aucun utilisateur trouvé</p>
            </div>
        </div>
    </div>
</div>

<script>
    // Éléments DOM
    const searchInput = document.getElementById('searchInput');
    const searchBtn = document.getElementById('searchBtn');
    const resetBtn = document.getElementById('resetBtn');
    const tableBody = document.getElementById('userTableBody');
    const noResultDiv = document.getElementById('noResult');
    const totalUsersSpan = document.getElementById('totalUsers');
    const totalPatientsSpan = document.getElementById('totalPatients');
    const totalPsychologuesSpan = document.getElementById('totalPsychologues');
    const totalAdminsSpan = document.getElementById('totalAdmins');
    
    // Fonction de recherche
    function searchUsers() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const rows = tableBody.querySelectorAll('tr');
        let visibleCount = 0;
        let visiblePatients = 0;
        let visiblePsychologues = 0;
        let visibleAdmins = 0;
        
        rows.forEach(row => {
            const name = row.getAttribute('data-name') || '';
            const email = row.getAttribute('data-email') || '';
            const role = row.getAttribute('data-role') || '';
            
            if (searchTerm === '') {
                row.style.display = '';
                visibleCount++;
                // Compter les rôles
                if (role === 'patient') visiblePatients++;
                else if (role === 'psychologue') visiblePsychologues++;
                else if (role === 'admin') visibleAdmins++;
            } else {
                if (name.includes(searchTerm) || email.includes(searchTerm) || role.includes(searchTerm)) {
                    row.style.display = '';
                    visibleCount++;
                    if (role === 'patient') visiblePatients++;
                    else if (role === 'psychologue') visiblePsychologues++;
                    else if (role === 'admin') visibleAdmins++;
                } else {
                    row.style.display = 'none';
                }
            }
        });
        
        // Mettre à jour les statistiques
        totalUsersSpan.textContent = visibleCount;
        totalPatientsSpan.textContent = visiblePatients;
        totalPsychologuesSpan.textContent = visiblePsychologues;
        totalAdminsSpan.textContent = visibleAdmins;
        
        // Afficher/masquer le message "aucun résultat"
        if (visibleCount === 0) {
            noResultDiv.style.display = 'block';
        } else {
            noResultDiv.style.display = 'none';
        }
    }
    
    // Fonction de réinitialisation
    function resetSearch() {
        searchInput.value = '';
        searchUsers();
    }
    
    // Écouteurs d'événements
    searchBtn.addEventListener('click', searchUsers);
    resetBtn.addEventListener('click', resetSearch);
    searchInput.addEventListener('keyup', function(e) {
        if (e.key === 'Enter') {
            searchUsers();
        }
    });
    
    // Initialisation
    searchUsers();
</script>
{% endblock %}